{%- liquid
  assign options = section.settings
  assign search_placeholder = options.search_placeholder | default: 'Search products...'
  assign results_per_category = options.results_per_category | default: 8
  assign bestseller_collection = options.bestseller_collection | default: 'boost-all'
  assign show_custom_buttons = options.show_custom_buttons
  assign color_scheme = settings.default_color_scheme
  if options.color_scheme_variant == 'own'
    assign color_scheme = options.color_scheme
  endif
-%}

<section class="pv-search" data-section-id="{{ section.id }}">
  <form action="{{ routes.search_url }}" method="get" class="pv-search__form" role="search" autocomplete="off">
    <input type="hidden" name="type" value="product">
    <div class="pv-search__icon" aria-hidden="true">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
        <path d="M21 21l-4.35-4.35m1.35-5.65a7 7 0 1 1-14 0 7 7 0 0 1 14 0z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </div>
    <input 
      class="pv-search__input" 
      type="search" 
      name="q" 
      placeholder="{{ search_placeholder }}" 
      aria-label="{{ 'general.search.search' | t }}"
    >
  </form>

  <div id="ps-results-{{ section.id }}" class="ps-results" hidden></div>
</section>

<style>
  /* --- Base styling (normal inline state) --- */
  .pv-search {
    position: relative;
    padding: 10px 0;
    transition: all 0.25s ease;
  }

  /* --- Floating state (when active) --- */
  .pv-search--active {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    background: rgba(255,255,255,0.95);
    box-shadow: 0 8px 20px rgba(0,0,0,.08);
    z-index: 9999;
    padding: 12px 0;
    backdrop-filter: blur(6px);
  }

  /* Search bar styling */
  .pv-search__form {
    position: relative;
    display: grid;
    grid-template-columns: 40px 1fr;
    align-items: center;
    height: 48px;
    border-radius: 999px;
    background: #fff;
    border: 1px solid #eee;
    box-shadow: 0 12px 28px rgba(0,0,0,.06);
    width: min(100% - 32px, 900px);
    margin: 0 auto;
    transition: all 0.25s ease;
  }

  .pv-search__icon {
    display: grid;
    place-items: center;
    opacity: .7;
  }

  .pv-search__input {
    width: 100%;
    height: 100%;
    border: 0;
    outline: 0;
    background: transparent;
    padding: 0 16px;
    font-size: 15px;
    color: #111;
  }

  .pv-search__input::placeholder {
    color: #9aa3ad;
  }

  @media (max-width: 480px) {
    .pv-search__form {
      height: 46px;
    }
    .pv-search__input {
      font-size: 14px;
      padding: 0 12px;
    }
  }

  /* Predictive search dropdown */
  .ps-results {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    top: calc(100% + 8px);
    width: min(100% - 32px, 900px);
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 14px;
    box-shadow: 0 12px 28px rgba(0,0,0,.12);
    overflow: auto;
    max-height: 60vh;
    text-align: left;
    z-index: 10000;
  }

  .ps-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    text-decoration: none;
    color: #111;
    transition: background 0.15s ease;
  }

  .ps-item:hover {
    background: #f9fafb;
  }

  .ps-thumb {
    width: 46px;
    height: 46px;
    border-radius: 8px;
    object-fit: cover;
    background: #f3f4f6;
    flex-shrink: 0;
  }

  .ps-info {
    flex: 1;
  }

  .ps-title {
    font-weight: 600;
    line-height: 1.2;
    margin-bottom: 4px;
  }

  .ps-price {
    color: #6b7280;
    font-size: 13px;
  }

  .ps-price s {
    opacity: .6;
    margin-left: 6px;
  }

  .ps-empty {
    padding: 20px 14px;
    text-align: center;
    color: #6b7280;
  }

  .ps-footer {
    background: #000;
    color: #fff;
    padding: 14px;
    text-align: center;
    border-radius: 0 0 14px 14px;
    margin-top: 8px;
  }

  .ps-footer a {
    color: #fff;
    font-weight: 700;
    text-decoration: none;
    font-size: 15px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: opacity 0.2s ease;
  }

  .ps-footer a:hover {
    opacity: 0.8;
  }

  /* Custom buttons when there are no results */
  .ps-custom {
    padding: 14px;
    border-top: 1px solid #e5e7eb;
    text-align: center;
  }

  .ps-custom-title {
    font-weight: 600;
    margin-bottom: 8px;
  }

  .ps-custom-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
    margin-top: 8px;
  }

  .ps-custom-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 8px 16px;
    border-radius: 999px;
    border: 1px solid #111;
    background: #fff;
    color: #111;
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  .ps-custom-btn:hover {
    background: #111;
    color: #fff;
  }

  .ps-loading {
    padding: 20px;
    text-align: center;
    color: #6b7280;
  }
</style>

<script>
(function(){
  const SECTION_ID = '{{ section.id }}';
  const BESTSELLER_HANDLE = '{{ bestseller_collection }}';
  const SHOW_CUSTOM_BUTTONS = {{ show_custom_buttons }};
  const RESULTS_LIMIT = {{ results_per_category }};

  const section = document.querySelector('.pv-search[data-section-id="' + SECTION_ID + '"]');
  const form = section?.querySelector('.pv-search__form');
  const input = section?.querySelector('.pv-search__input');
  const box = document.getElementById('ps-results-' + SECTION_ID);
  
  if (!section || !form || !input || !box) return;

  /* --- FLOATING LOGIC --- */
  input.addEventListener('focus', () => {
    section.classList.add('pv-search--active');
  });

  document.addEventListener('click', e => {
    if (!section.contains(e.target)) {
      section.classList.remove('pv-search--active');
      box.hidden = true;
    }
  });

  /* --- Predictive search logic --- */
  let controller, timer, bestsellerIndex;

  function money(cents){
    try {
      return Shopify.formatMoney(cents);
    } catch(e) {
      return '€' + (cents / 100).toFixed(2);
    }
  }

  async function loadBestsellers(){
    if (bestsellerIndex) return bestsellerIndex;
    try {
      const r = await fetch('/collections/' + BESTSELLER_HANDLE + '/products.json?limit=250');
      const data = await r.json();
      bestsellerIndex = {};
      (data.products || []).forEach((p, i) => {
        bestsellerIndex[p.handle] = i;
      });
    } catch(e) {
      bestsellerIndex = {};
    }
    return bestsellerIndex;
  }

  async function getPrice(handle){
    try {
      const r = await fetch('/products/' + handle + '.js');
      const p = await r.json();
      const prices = p.variants.map(v => +v.price);
      const comp = p.variants.map(v => v.compare_at_price ? +v.compare_at_price : Infinity);
      return {
        price_cents: Math.min.apply(null, prices),
        compare_cents: isFinite(Math.min.apply(null, comp)) ? Math.min.apply(null, comp) : null
      };
    } catch(e) {
      return {};
    }
  }

  function footerHTML(q){
    const url = q && q.length ? ('{{ routes.search_url }}?type=product&q=' + encodeURIComponent(q)) : '{{ routes.search_url }}';
    return '<div class="ps-footer"><a href="' + url + '">View All Results →</a></div>';
  }

  function renderNoResults(q){
    let html = '<div class="ps-empty">No products found for "' + q + '"</div>';
    
    {% if section.settings.show_custom_buttons %}
    html += '<div class="ps-custom">' +
      '<div class="ps-custom-title">{{ section.settings.custom_buttons_title }}</div>' +
      '<div class="ps-custom-buttons">';
    
    {% for block in section.blocks %}
      {% if block.type == 'custom_button' %}
        html += '<a class="ps-custom-btn" href="{{ block.settings.button_link }}">{{ block.settings.button_label }}</a>';
      {% endif %}
    {% endfor %}
    
    html += '</div></div>';
    {% endif %}
    
    html += footerHTML(q);
    box.innerHTML = html;
    box.hidden = false;
  }

  function render(items, q){
    if (!items.length){
      renderNoResults(q);
      return;
    }

    const list = items.map(it => {
      let priceHtml = '';
      if (typeof it.price_cents === 'number'){
        priceHtml = '<div class="ps-price">' + money(it.price_cents);
        if (it.compare_cents && it.compare_cents > it.price_cents) {
          priceHtml += ' <s>' + money(it.compare_cents) + '</s>';
        }
        priceHtml += '</div>';
      }
      
      const thumb = it.image ? (it.image + (it.image.includes('?') ? '&' : '?') + 'width=92') : '';
      
      return '<a class="ps-item" href="' + it.url + '">' +
        (thumb ? '<img class="ps-thumb" src="' + thumb + '" alt="' + it.title + '" loading="lazy">' : '<div class="ps-thumb"></div>') +
        '<div class="ps-info">' +
          '<div class="ps-title">' + it.title + '</div>' + 
          priceHtml +
        '</div>' +
        '</a>';
    }).join('');

    box.innerHTML = list + footerHTML(q);
    box.hidden = false;
  }

  async function search(q){
    if (controller) controller.abort();
    controller = new AbortController();
    
    box.innerHTML = '<div class="ps-loading">Searching...</div>';
    box.hidden = false;
    
    const url = '/search/suggest.json?q=' + encodeURIComponent(q) + '&resources[type]=product&resources[limit]=' + RESULTS_LIMIT;
    
    try {
      const data = await fetch(url, { signal: controller.signal }).then(r => r.json());
      const prods = (data.resources && data.resources.results && data.resources.results.products) || [];

      const items = prods.map(p => {
        const handle = (p.url || '').split('/products/')[1]?.split('?')[0] || '';
        return { title: p.title, url: p.url, image: p.image, handle };
      });

      await Promise.all(items.map(async it => {
        if (it.handle){
          Object.assign(it, await getPrice(it.handle));
        }
      }));

      if (BESTSELLER_HANDLE) {
        const idx = await loadBestsellers();
        items.sort((a, b) => {
          const ra = (a.handle in idx) ? idx[a.handle] : Number.MAX_SAFE_INTEGER;
          const rb = (b.handle in idx) ? idx[b.handle] : Number.MAX_SAFE_INTEGER;
          return ra - rb;
        });
      }

      render(items, q);
    } catch(e) {
      if (e.name !== 'AbortError') {
        box.innerHTML = '<div class="ps-empty">Error loading results</div>';
      }
    }
  }

  input.addEventListener('input', function(){
    const q = this.value.trim();
    if (!q){
      box.hidden = true;
      box.innerHTML = '';
      return;
    }
    clearTimeout(timer);
    timer = setTimeout(() => search(q), 300);
  });
})();
</script>

{% schema %}
{
  "name": "Predictive Search Bar",
  "tag": "section",
  "class": "section-predictive-search",
  "settings": [
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search Placeholder",
      "default": "Search products..."
    },
    {
      "type": "range",
      "id": "results_per_category",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8,
      "label": "Results per search"
    },
    {
      "type": "text",
      "id": "bestseller_collection",
      "label": "Bestseller Collection Handle",
      "info": "Products will be sorted by this collection's order (e.g., 'bestsellers')",
      "default": "boost-all"
    },
    {
      "type": "header",
      "content": "Custom Buttons (No Results)"
    },
    {
      "type": "checkbox",
      "id": "show_custom_buttons",
      "label": "Show custom buttons when no results",
      "default": false
    },
    {
      "type": "text",
      "id": "custom_buttons_title",
      "label": "Custom buttons title",
      "default": "Can't find what you're looking for?"
    },
    {
      "type": "header",
      "content": "Color Scheme"
    },
    {
      "type": "select",
      "id": "color_scheme_variant",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "own",
          "label": "Custom"
        }
      ],
      "default": "default",
      "label": "Color scheme variant"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-1",
      "label": "Color scheme"
    }
  ],
  "blocks": [
    {
      "type": "custom_button",
      "name": "Custom Button",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "Custom Product"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Predictive Search Bar",
      "blocks": []
    }
  ]
}
{% endschema %}
