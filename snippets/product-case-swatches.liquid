{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign swatch_patterns = settings.primary_custom_colors_and_patterns
  if is_primary_swatch == false
    assign swatch_patterns = settings.secondary_custom_colors_and_patterns
  endif

  assign primary_custom_colors_and_patterns = swatch_patterns | newline_to_br | split: '<br />'
  assign enable_darken_mode = false
  if settings.enable_product_darken_background and settings.darken_background_mix_mode != 'none'
    assign enable_darken_mode = true
  endif

  assign current_color_scheme = 'default'
  assign target_color_scheme = section.settings.color_scheme
  assign option_name_downcase = option.name | downcase

  assign block_option_name_downcase = block.settings.option_name | downcase
  assign information_drawer_button_label = block.settings.information_drawer_button_label
  assign information_drawer_button_position = block.settings.information_drawer_button_position
  assign information_drawer_icon_type = block.settings.information_drawer_icon_type
  assign information_drawer_button_icon = block.settings.information_drawer_button_icon
  assign information_drawer_button_custom_icon = block.settings.information_drawer_button_custom_icon

  if section.settings.color_scheme == 'default'
    assign target_color_scheme = settings.default_color_scheme
  endif

  case target_color_scheme
    when 'primary'
      assign current_color_scheme = 'primary'
    when 'secondary'
      assign current_color_scheme = 'secondary'
    when 'custom-1'
      assign current_color_scheme = 'custom_1'
    when 'custom-2'
      assign current_color_scheme = 'custom_2'
    when 'custom-3'
      assign current_color_scheme = 'custom_3'
  endcase

  assign key = current_color_scheme | append: '_background_color'
  assign section_background_color = settings[key] | downcase

   assign cp_variant = product.selected_or_first_available_variant

    if cp_variant.title != blank
        assign cp_variant_title = cp_variant.title | downcase
    else
        assign cp_variant_title = "Samsung" | downcase
    endif

    assign color_option_picker_type = color_option_picker_type
    assign case_popup_pt = ''

    for case_popup in shop.metaobjects.case_popup.values
        assign case_popup_brand = case_popup.brand | downcase | strip

        if cp_variant_title contains case_popup_brand
            assign case_popup_pt = case_popup
        endif
    endfor
-%}

<color-swatches-picker>
    <div class='product-variant-picker__option-label'>
        <span class='heading-font-family'>{{ option.name }}</span>
        {% if information_drawer_button_position == 'left' %}{{ drawer_button }}{% endif %}

        <span
        class='truncate product-variant-picker__option-active-color body-color'
        data-color-swatches-picker-active-value
        >
        {{- option.selected_value -}}
        </span>

        {% if case_popup_pt != blank %}
            <div class="learn_more_label" js-popup-open data-id="popup-case">
                <svg xmlns="http://www.w3.org/2000/svg" id="information-button" width="23.625" height="23.625" viewBox="0 0 23.625 23.625">
                <path id="Path_1" data-name="Path 1" d="M11.812,0A11.813,11.813,0,1,0,23.625,11.812,11.813,11.813,0,0,0,11.812,0Zm2.459,18.307q-.912.36-1.455.548a3.838,3.838,0,0,1-1.262.189A2.515,2.515,0,0,1,9.837,18.5a1.739,1.739,0,0,1-.611-1.367,4.966,4.966,0,0,1,.045-.659c.031-.224.08-.476.147-.759l.761-2.688c.067-.258.125-.5.171-.731a3.241,3.241,0,0,0,.068-.633.975.975,0,0,0-.212-.717,1.2,1.2,0,0,0-.813-.2,2.134,2.134,0,0,0-.605.09c-.2.063-.383.12-.529.176l.2-.828q.747-.3,1.43-.521a4.225,4.225,0,0,1,1.29-.218,2.468,2.468,0,0,1,1.692.53,1.761,1.761,0,0,1,.594,1.376q0,.175-.041.617a4.129,4.129,0,0,1-.152.811l-.757,2.68c-.062.215-.117.461-.167.736a3.892,3.892,0,0,0-.073.626.9.9,0,0,0,.239.728,1.338,1.338,0,0,0,.827.194,2.4,2.4,0,0,0,.626-.1,3.559,3.559,0,0,0,.506-.17ZM14.137,7.429a1.807,1.807,0,0,1-1.275.492,1.826,1.826,0,0,1-1.28-.492,1.571,1.571,0,0,1-.533-1.193,1.586,1.586,0,0,1,.533-1.2,1.812,1.812,0,0,1,1.28-.5,1.792,1.792,0,0,1,1.275.5,1.611,1.611,0,0,1,0,2.389Z" fill="#000"/>
                <wps-translate-entry xmlns=""/></svg>
                <span class="learn_more_text_label">
                    {% if localization.language.iso_code == "de" %}
                        Mehr erfahren
                    {% elsif localization.language.iso_code == "fr" %}
                        En savoir plus
                    {% else %}
                        learn more
                    {% endif %}
                </span>
            </div>

            {% render "case-popup", case_popup: case_popup_pt %}
        {% endif %}

        {% if information_drawer_button_position == 'right' %}{{ drawer_button }}{% endif %}
    </div>

    <div class='case-swatch__grid' js-case-swatch>
        {%- for value in option.values -%}
            {%- liquid
                assign case_downcase = value | downcase | strip

                assign is_image = false
                assign swatch_img = ''
                assign swatch_popup = ''
                assign cr_variant = value.variant

                if current_variant.title != blank
                    assign current_variant_title = current_variant.title | downcase
                else
                    assign current_variant_title = "Samsung" | downcase
                endif

                for case_type in shop.metaobjects.case_type.values
                    assign case_type_name = case_type.name | downcase | strip
                    assign case_type_brand = case_type.brand | downcase | strip

                    if case_type_name == case_downcase and current_variant_title contains case_type_brand
                        assign swatch_img = case_type.image | image_url: width: '600x'
                        assign swatch_popup = case_type
                        assign is_image = true
                    endif
                endfor
            -%}

            {% if cr_variant != blank and swatch_img != blank and cr_variant.available %}
                <div class="case-swatch__item">
                    <label
                        for='{{ sectionId }}-{{ product.id }}-{{ option.position }}-{{ forloop.index0 }}'
                        class='case-swatch-select-parent {% if value.selected %} selected {% endif %}'
                        {% if value.selected %}
                        tabindex='0'
                        {% endif %}
                        data-focus-trap-target
                        data-color-swatches-picker-label
                        data-value='{{ value | escape }}'
                        {% unless value.available %}
                        no-available
                        {% endunless %}
                        js-case-label
                    >
                        <shape-swatch
                            data-color='{{ case_downcase }}'
                            class='case-swatch'
                            is-image
                        >
                            <div class='case-swatch__img'>
                                {{ swatch_img | image_tag }}
                            </div>
                            <div class='case-swatch__details'>
                                <span class="case-swatch__value">{{ value }}</span>
                                {% if cr_variant.compare_at_price > cr_variant.price %}
                                    <div class="case-price__grid">
                                        <span class="case-compare-price case-price">{{ cr_variant.compare_at_price | money }}</span>
                                        <span class="case-price regular__price">{{ cr_variant.price | money }}</span>
                                    </div>
                                {% else %}
                                    <span class="case-price">{{ cr_variant.price | money }}</span>
                                {% endif %}
                            </div>
                        </shape-swatch>
                    </label>
                    {% if swatch_popup.popup_image != blank or swatch_popup.popup_rte != blank %}
                        <div class="learn_more_btn" js-popup-open data-id="popup-{{ cr_variant.id }}">
                            <svg xmlns="http://www.w3.org/2000/svg" id="information-button" width="23.625" height="23.625" viewBox="0 0 23.625 23.625">
                            <path id="Path_1" data-name="Path 1" d="M11.812,0A11.813,11.813,0,1,0,23.625,11.812,11.813,11.813,0,0,0,11.812,0Zm2.459,18.307q-.912.36-1.455.548a3.838,3.838,0,0,1-1.262.189A2.515,2.515,0,0,1,9.837,18.5a1.739,1.739,0,0,1-.611-1.367,4.966,4.966,0,0,1,.045-.659c.031-.224.08-.476.147-.759l.761-2.688c.067-.258.125-.5.171-.731a3.241,3.241,0,0,0,.068-.633.975.975,0,0,0-.212-.717,1.2,1.2,0,0,0-.813-.2,2.134,2.134,0,0,0-.605.09c-.2.063-.383.12-.529.176l.2-.828q.747-.3,1.43-.521a4.225,4.225,0,0,1,1.29-.218,2.468,2.468,0,0,1,1.692.53,1.761,1.761,0,0,1,.594,1.376q0,.175-.041.617a4.129,4.129,0,0,1-.152.811l-.757,2.68c-.062.215-.117.461-.167.736a3.892,3.892,0,0,0-.073.626.9.9,0,0,0,.239.728,1.338,1.338,0,0,0,.827.194,2.4,2.4,0,0,0,.626-.1,3.559,3.559,0,0,0,.506-.17ZM14.137,7.429a1.807,1.807,0,0,1-1.275.492,1.826,1.826,0,0,1-1.28-.492,1.571,1.571,0,0,1-.533-1.193,1.586,1.586,0,0,1,.533-1.2,1.812,1.812,0,0,1,1.28-.5,1.792,1.792,0,0,1,1.275.5,1.611,1.611,0,0,1,0,2.389Z" fill="#000"></path>
                            <wps-translate-entry xmlns=""></wps-translate-entry></svg>
                            <span class="learn_more_btn_label">
                                {% if localization.language.iso_code == "de" %}
                                    Mehr erfahren
                                {% elsif localization.language.iso_code == "fr" %}
                                    En savoir plus
                                {% else %}
                                    learn more
                                {% endif %}
                            </span>
                        </div>
                    {% endif %}
                </div>

                {% if swatch_popup.popup_image != blank or swatch_popup.popup_rte != blank %}
                    {% render "swatch-popup", swatch_popup: swatch_popup, cr_variant: cr_variant %}
                {% endif %}
            {% endif %}
        {%- endfor -%}
    </div>
</color-swatches-picker>