2k<\/span>\n        <\/a>\n        <a href=\"https:\/\/www.tiktok.com\/@hermano2k\/video\/7458649534487399702\" target=\"_blank\" rel=\"noopener\" class=\"mobile-tiktok-btn\">\n          <img src=\"https:\/\/cdn-icons-png.flaticon.com\/512\/3046\/3046121.png\" alt=\"\">\n        <\/a>\n        <button class=\"sound-toggle\" aria-label=\"Toggle sound\">🔇<\/button>\n        <input type=\"range\" class=\"seek-bar\" value=\"0\" min=\"0\" max=\"100\" step=\"0.1\" aria-label=\"Seek\">\n      <\/div>\n\n      <!-- VIDEO 2 -->\n      <div class=\"video-item\" tabindex=\"0\">\n        <video preload=\"auto\" autoplay muted loop playsinline>\n          <source src=\"https:\/\/cdn.shopify.com\/videos\/c\/o\/v\/e2f0d41fddec487bab7226bb425a9bc3.mp4\" type=\"video\/mp4\">\n        <\/video>\n        <a href=\"https:\/\/www.tiktok.com\/@joonas.v.lappalainen\/video\/7453509183493770518\" target=\"_blank\" rel=\"noopener\" class=\"video-credit desktop-credit\">\n          <img src=\"https:\/\/cdn-icons-png.flaticon.com\/512\/3046\/3046121.png\" alt=\"\" class=\"tiktok-logo\"><span class=\"handle-text\">@joonas.v.lappalainen<\/span>\n        <\/a>\n        <a href=\"https:\/\/www.tiktok.com\/@joonas.v.lappalainen\/video\/7453509183493770518\" target=\"_blank\" rel=\"noopener\" class=\"mobile-tiktok-btn\">\n          <img src=\"https:\/\/cdn-icons-png.flaticon.com\/512\/3046\/3046121.png\" alt=\"\">\n        <\/a>\n        <button class=\"sound-toggle\" aria-label=\"Toggle sound\">🔇<\/button>\n        <input type=\"range\" class=\"seek-bar\" value=\"0\" min=\"0\" max=\"100\" step=\"0.1\" aria-label=\"Seek\">\n      <\/div>\n    <\/div>\n  <\/div>\n<\/div>\n\n<style>\n.video-gallery{ text-align:center;padding:60px 0;background:#fff;color:#3B3933;overflow:hidden }\n.video-title{ font-family:'Figtree';font-weight:600;font-size:2.7rem;margin-bottom:40px }\n\n\/* Slider \/ track *\/\n.video-slider{ position:relative;overflow:hidden;width:100% }\n.video-track{\n  display:flex;gap:16px;flex-wrap:nowrap!important;white-space:nowrap;\n  align-items:flex-start;animation:videoMarquee 35s linear infinite;\n  will-change:transform;transform:translate3d(0,0,0);backface-visibility:hidden\n}\n.video-track>*{ margin:0!important }\n.video-slider:hover .video-track{ animation-play-state:paused }\n@keyframes videoMarquee{ from{transform:translate3d(0,0,0)} to{transform:translate3d(-50%,0,0)} }\n\n\/* Desktop: JS controls movement; disable CSS marquee *\/\n@media (min-width:901px){ .video-track{ animation:none!important;will-change:transform } }\n\n\/* Cards *\/\n.video-item{\n  box-sizing:border-box;contain:layout paint;content-visibility:auto;\n  contain-intrinsic-size:568px 320px;position:relative;flex:0 0 auto;\n  width:320px;min-width:320px;aspect-ratio:9\/16;min-height:calc(320px * 16\/9);\n  border-radius:16px;overflow:hidden;background:#111;cursor:pointer;vertical-align:top\n}\n.video-item video{ display:block;width:100%!important;height:100%!important;object-fit:cover!important;pointer-events:none }\n\n\/* Pause overlay *\/\n.video-item.paused::after{\n  content:\"▶\";position:absolute;inset:0;display:grid;place-items:center;\n  font-size:48px;color:#fff;opacity:.85;pointer-events:none;z-index:4\n}\n\n\/* Credits \/ UI *\/\n.video-credit{\n  position:absolute;top:10px;left:10px;display:flex;gap:6px;align-items:center;\n  background:rgba(0,0,0,.55);color:#fff;padding:4px 10px;border-radius:8px;\n  z-index:3;backdrop-filter:blur(4px);text-decoration:none;font-weight:600;font-size:14px\n}\n.tiktok-logo{ width:15px;height:15px;flex:0 0 15px }\n@media(max-width:900px){ .desktop-credit{ display:none } }\n@media(max-width:900px){\n  .mobile-tiktok-btn{ position:absolute;top:8px;left:8px;width:36px;height:36px;border-radius:50%;\n    display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,.55);z-index:3 }\n  .mobile-tiktok-btn img{ width:20px;height:20px }\n  \/* PHONE: absolutely no movement *\/\n  .video-track{ animation:none!important; transform:none!important }\n}\n.sound-toggle{\n  position:absolute;top:8px;right:8px;width:36px;height:36px;border-radius:50%;\n  border:0;background:rgba(0,0,0,.5);color:#fff;font-size:20px;z-index:3\n}\n.seek-bar{\n  position:absolute;left:10px;right:10px;bottom:13px;height:5px;border-radius:3px;z-index:3;\n  -webkit-appearance:none;background:rgba(255,255,255,.3)\n}\n.seek-bar::-webkit-slider-thumb{\n  -webkit-appearance:none;width:12px;height:12px;border-radius:50%;background:#fff;margin-top:-1.3px\n}\n\n\/* Desktop fades *\/\n@media(min-width:901px){\n  .video-slider::before,.video-slider::after{\n    content:\"\";position:absolute;top:0;width:120px;height:100%;pointer-events:none;z-index:2\n  }\n  .video-slider::before{ left:0;background:linear-gradient(to right,#fff 0%,transparent 100%) }\n  .video-slider::after { right:0;background:linear-gradient(to left ,#fff 0%,transparent 100%) }\n}\n\n\/* Mobile grid (unchanged layout) *\/\n@media(max-width:900px){\n  .video-track{ flex-wrap:wrap!important;justify-content:center;align-items:flex-start }\n  .video-item{ width:45%!important;min-width:45%!important;min-height:auto }\n}\n\n\/* Reduced motion *\/\n@media (prefers-reduced-motion:reduce){ .video-track{ animation:none!important } }\n<\/style>\n\n<script>\ndocument.addEventListener('DOMContentLoaded', () => {\n  const slider = document.querySelector('.video-slider');\n  const track  = document.getElementById('videoTrack');\n  if (!slider || !track) return;\n\n  \/* ---- existing video wiring ---- *\/\n  function startProgressLoop(video, seek){\n    if (video.__looping) return;\n    video.__looping = true;\n    const tick = () => {\n      if (!video.__visible){ video.__looping = false; return; }\n      const d = video.duration;\n      if (d && isFinite(d)) seek.value = (video.currentTime \/ d) * 100 || 0;\n      requestAnimationFrame(tick);\n    };\n    requestAnimationFrame(tick);\n  }\n\n  function wireItem(item){\n    const video = item.querySelector('video');\n    const sound = item.querySelector('.sound-toggle');\n    const seek  = item.querySelector('.seek-bar');\n\n    item.addEventListener('click', (e) => {\n      if (e.target === sound || e.target === seek || e.target.closest('.mobile-tiktok-btn') || e.target.closest('.video-credit')) return;\n      if (video.paused){ video.play().catch(()=>{}); item.classList.remove('paused'); }\n      else { video.pause(); item.classList.add('paused'); }\n    });\n    sound.addEventListener('click',(e)=>{ e.stopPropagation(); video.muted=!video.muted; sound.textContent=video.muted?'🔇':'🔊'; if(!video.muted){ video.play().catch(()=>{}); item.classList.remove('paused'); }});\n    seek.addEventListener('input',()=>{ const d=video.duration; if(d&&isFinite(d)) video.currentTime=(seek.value\/100)*d; });\n\n    video.preload='metadata'; video.muted=true; video.__visible=false;\n    const onVisible=()=>{ if(!video.__visible){ video.__visible=true; video.play().catch(()=>{}); startProgressLoop(video,seek); } };\n    const onHidden =()=>{ if(video.__visible){ video.__visible=false; video.pause(); } };\n    ['loadedmetadata','durationchange','canplay','playing'].forEach(evt=>video.addEventListener(evt,()=>{ if(video.__visible) startProgressLoop(video,seek); }));\n    return { item, video, onVisible, onHidden };\n  }\n\n  let controllers = [...track.querySelectorAll('.video-item')].map(wireItem);\n  const elementToController = new Map(controllers.map(c=>[c.item,c]));\n  const io = new IntersectionObserver((ents)=>{ ents.forEach(e=>{ const c=elementToController.get(e.target); if(!c) return; e.isIntersecting?c.onVisible():c.onHidden(); }); }, {root:null,threshold:0.25});\n  controllers.forEach(c=>io.observe(c.item));\n\n  \/* ---- DESKTOP-ONLY conveyor (slower) ---- *\/\n  const mq = window.matchMedia('(min-width:901px)');\n  const isDesktop = () => mq.matches;\n\n  let rafId=null,lastTs=0,offsetX=0,paused=false, cardW=0, gap=0;\n  const SPEED = 16; \/\/ px\/sec on desktop (slower)\n\n  function getGap(){\n    const cs=getComputedStyle(track);\n    const g=parseFloat(cs.columnGap||cs.gap||'16');\n    return isFinite(g)?g:16;\n  }\n  function calcCardW(){\n    const first=track.querySelector('.video-item');\n    if(!first) return 0;\n    const rect=first.getBoundingClientRect();\n    gap=getGap();\n    return rect.width + gap;\n  }\n\n  const originals = [...track.querySelectorAll('.video-item:not([data-clone])')];\n\n  function wireAndObserve(nodes){\n    const newCtrls = nodes.map(wireItem);\n    newCtrls.forEach(c=>{ elementToController.set(c.item,c); io.observe(c.item); });\n    controllers = controllers.concat(newCtrls);\n  }\n\n  function ensureFilled(){\n    \/\/ remove old desktop clones\n    track.querySelectorAll('.video-item[data-clone=\"1\"]').forEach(n=>{\n      io.unobserve(n); elementToController.delete(n); n.remove();\n    });\n    controllers = controllers.filter(c=>!c.item.dataset.clone);\n\n    cardW = calcCardW();\n    if(!cardW) return;\n\n    const sliderW = slider.getBoundingClientRect().width;\n    \/\/ fill view + 2-card buffer\n    const need = Math.ceil((sliderW + cardW*2)\/cardW);\n    const have = track.querySelectorAll('.video-item').length;\n    const toAdd = Math.max(0, need - have);\n\n    const clones=[];\n    for(let i=0;i<toAdd;i++){\n      const src = originals[i % originals.length];\n      const c = src.cloneNode(true);\n      c.dataset.clone=\"1\";\n      clones.push(c);\n      track.appendChild(c);\n    }\n    if(clones.length) wireAndObserve(clones);\n  }\n\n  function step(ts){\n    if(!isDesktop()){ stopDesktop(); return; }\n    const dt = lastTs ? (ts-lastTs)\/1000 : 0;\n    lastTs = ts;\n\n    if(!paused){\n      offsetX -= SPEED * dt;\n      cardW = cardW || calcCardW();\n      if(cardW>0 && -offsetX >= cardW){\n        track.appendChild(track.firstElementChild);\n        offsetX += cardW;\n      }\n      track.style.transform = `translate3d(${offsetX}px,0,0)`;\n    }\n    rafId = requestAnimationFrame(step);\n  }\n\n  function startDesktop(){\n    if(rafId) return;\n    ensureFilled();\n    offsetX=0; lastTs=0; paused=false;\n    track.style.transform='translate3d(0,0,0)';\n    track.addEventListener('mouseenter',()=>paused=true);\n    track.addEventListener('mouseleave',()=>paused=false);\n    window.addEventListener('resize', ensureFilled);\n    rafId = requestAnimationFrame(step);\n  }\n\n  function stopDesktop(){\n    if(rafId){ cancelAnimationFrame(rafId); rafId=null; }\n    window.removeEventListener('resize', ensureFilled);\n    track.style.transform='translate3d(0,0,0)';\n    offsetX=0;\n    \/\/ remove clones so mobile stays at exactly 2 items and still (no movement)\n    track.querySelectorAll('.video-item[data-clone=\"1\"]').forEach(n=>{\n      io.unobserve(n); elementToController.delete(n); n.remove();\n    });\n    controllers = controllers.filter(c=>!c.item.dataset.clone);\n  }\n\n  if(isDesktop()) startDesktop();\n  mq.addEventListener('change', e => { e.matches ? startDesktop() : stopDesktop(); });\n\n  document.addEventListener('visibilitychange',()=>{ if(isDesktop()) paused = document.hidden; });\n});\n<\/script>","container_size":"large","round_level":"default","color_scheme_variant":"default","color_scheme":"","show_background":false,"add_desktop_side_paddings":true,"add_mobile_side_paddings":true,"section_spacing_top":"none","section_spacing_bottom":"none"}},"before_after_images_e6dUAH":{"type":"before-after-images","name":"t:sections.before_after_images.name","settings":{"layout":"right","desktop_image_ratio":0.7,"mobile_image_ratio":1,"drag":50,"subheading":"BEFORE\/AFTER IMAGES","heading":"Spot the difference","heading_size":"h2","body_richtext":"<p>Out with the old, in with the one that’s truly your's — your skis, your style.<br\/><br\/><\/p>","body_size":"body3","content_alignment":"center","content_paddings_size":"xl","btn_text":"","btn_url":"","btn_style":"primary","before_img":"shopify:\/\/shop_images\/test2_2bfd1545-6e73-40f8-bf44-9be3f7d2d5e8.pn